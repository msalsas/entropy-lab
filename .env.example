# Remote engine configuration (OpenAI-compatible server).
# Copy this file to .env and edit. Real environment variables override it.

# Active engine for the web app and run scripts: local | gguf | api.
# Use "api" to run everything against the remote server below.
LAB_ENGINE=api

# Base URL of the server (LM Studio default shown).
LAB_API_BASE=http://localhost:1234/v1

# API key (LM Studio ignores it; hosted providers require it).
LAB_API_KEY=not-needed

# Model identifiers EXACTLY as served by the server (check GET /models).
LAB_MODEL_A=qwen2.5-7b-instruct
LAB_MODEL_A_LABEL=Qwen2.5-7B-Instruct

LAB_MODEL_B=mistral-7b-instruct-v0.3
LAB_MODEL_B_LABEL=Mistral-7B-Instruct-v0.3

# Number of top logprobs requested per token (entropy approximation quality).
# NOTE: some providers cap this (e.g. Alibaba allows max 5). Keep it
# identical for both models so the approximation is symmetric.
LAB_TOP_LOGPROBS=20

# Set to true for aggregators like OpenRouter: only route to providers
# that support every request parameter. Without it, some requests
# silently drop logprobs and entropy comes out NaN.
LAB_REQUIRE_PARAMETERS=false

# Temperature extremes for the pairwise scripts (low vs high). The
# defaults barely move entropy in confident frontier models; 0.2/2.0
# produced usable gaps in practice.
LAB_TEMP_LOW=0.6
LAB_TEMP_HIGH=1.2
